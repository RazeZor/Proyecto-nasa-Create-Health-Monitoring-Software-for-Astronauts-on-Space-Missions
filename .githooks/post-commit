#!/bin/sh
# Si el cambio toca el contrato con el reloj, anota en <SMART_DIR>/PENDIENTES-VIGIA.md qué revisar en
# smart-monitor (tools/sincro-smart). Nunca bloquea: sin SMART_DIR o sin Python no hace nada.
PY=""
for c in python3 python py; do
  if "$c" -c "import sys; assert sys.version_info >= (3, 10)" >/dev/null 2>&1; then PY=$c; break; fi
done
[ -z "$PY" ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 0
"$PY" tools/sincro-smart/sincro_smart.py --desde HEAD~1 --hasta HEAD || true
exit 0
