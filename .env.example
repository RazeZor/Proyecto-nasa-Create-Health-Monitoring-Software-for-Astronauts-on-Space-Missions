# Copia este archivo a .env y completa los valores. .env no se sube al repositorio.
# Clave de api.nasa.gov (espejo de DONKI). Sin ella se usa DEMO_KEY, con límite de consultas.
NASA_API_KEY=
# Carpeta del datalake (por defecto pipelines/datalake/data).
DATALAKE_DIR=
# Dirección de apps/api vista desde el servidor de apps/web (por defecto http://127.0.0.1:8000).
# La app la consulta por su propio origen en /vigia-api, así que en la LAN solo se expone el puerto 3000.
# Se lee al compilar (`next build`).
VIGIA_API_INTERNA=
# Opcional: URL directa de la API desde el navegador; si la defines, se salta el proxy (necesita CORS).
NEXT_PUBLIC_VIGIA_API_URL=
# Reloj (Galaxy Watch4 vía smart-monitor, ver apps/api/AGENTES.md). La API lee este .env al arrancar.
# WebSocket /live del servidor smart-monitor. Vacío = ws://127.0.0.1:8765/live (smart-monitor en esta misma máquina).
SMART_URL=
# Pon 1 para no conectar con ningún reloj.
SMART_DESACTIVADO=
# Nombre configurado en cada reloj -> id de tripulante de la API, por ejemplo "Sebastián=1,Ana=2".
# Opcional: también se puede vincular desde la pantalla Dispositivo («Este es mi reloj»).
SMART_TRIPULANTES=
# Pon 1 para que un reloj con nombre desconocido cree un tripulante nuevo (por defecto se ignora).
SMART_AUTOREGISTRO=
# IP de esta máquina que se le sugiere al reloj. Necesaria si el PC tiene varias redes (hotspot `umbra` para el
# reloj + WiFi con internet): sin ella se sugiere la IP de salida a internet, que el reloj no alcanza. Ver docs/SETUP.md §8.
SMART_IP_LAN=

# Identidad: vacío exige sesión verificada. Solo para ensayos aislados, sin datos personales: 1.
VIGIA_IDENTIDAD_ENSAYO=
# Forzar cookie Secure cuando el proxy externo usa HTTPS.
VIGIA_COOKIE_SEGURA=
# Orígenes directos permitidos, separados por coma. Exportar antes de iniciar uvicorn; el proxy web no necesita CORS.
VIGIA_ORIGENES=
# Receptor de ensayo independiente. HTTP solo se acepta en loopback; fuera requiere HTTPS.
VIGIA_TIERRA_URL=
VIGIA_TIERRA_DB=
# Dos secretos distintos de al menos 32 caracteres; no van al navegador ni a Git.
VIGIA_TIERRA_CLAVE=
VIGIA_TIERRA_OPERADOR_CLAVE=
# Solo verificación: build y servidor aislados en .next-verificacion.
VIGIA_VERIFICACION=
# Espacio exclusivo de bases ficticias de visitantes. Vacío = apps/api/data/demostraciones/.
VIGIA_DEMO_DIR=
# Carpeta local del repo smart-monitor: los hooks anotan ahí (PENDIENTES-VIGIA.md) lo que un cambio de VIGÍA
# obliga a revisar. Vacía = no se anota nada.
SMART_DIR=
