# Copia este archivo a .env y completa los valores. .env no se sube al repositorio.
# Clave de api.nasa.gov (espejo de DONKI). Sin ella se usa DEMO_KEY, con límite de consultas.
NASA_API_KEY=
# Carpeta del datalake (por defecto pipelines/datalake/data).
DATALAKE_DIR=
# Dirección de apps/api vista desde el servidor de apps/web (por defecto http://127.0.0.1:8000).
# La app la consulta por su propio origen en /vigia-api, así que en la LAN solo se expone el puerto 3000.
# Se lee al compilar (`next build`).
VIGIA_API_INTERNA=
# Opcional: URL directa de la API desde el navegador; si la defines, se salta el proxy (necesita CORS).
NEXT_PUBLIC_VIGIA_API_URL=
